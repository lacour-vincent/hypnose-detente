{
  "name": "hypnose-detente",
  "version": "2.6.0-SNAPSHOT",
  "description": "Application that allows you to relax with self-hypnosis recordings.",
  "author": "lacour-vincent",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=24.12.x",
    "yarn": "1.22.22"
  },
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "prebuild:android": "expo prebuild --platform android --clean --no-install",
    "android": "expo run:android",
    "build-app": "bash scripts/build-app.sh",
    "install-app": "bash scripts/install-app.sh",
    "type-check": "tsc --noEmit",
    "format-check": "prettier --check \"**/src/**/*.{ts,tsx}\" --log-level=warn",
    "lint-check": "eslint \"**/src/**/*.{ts,tsx}\"",
    "doctor": "yarn expo-doctor",
    "validate": "npm-run-all --parallel type-check format-check lint-check",
    "test:unit": "jest --config=jest.unit.config.js",
    "test:integration": "jest --config=jest.integration.config.js",
    "test": "yarn run test:unit && yarn run test:integration",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@react-native-community/slider": "5.2.2",
    "@react-native-vector-icons/material-design-icons": "14.0.0",
    "@reduxjs/toolkit": "2.14.0",
    "expo": "58.0.23",
    "expo-application": "58.1.2",
    "expo-asset": "58.0.20",
    "expo-audio": "58.0.11",
    "expo-build-properties": "58.0.12",
    "expo-constants": "58.0.15",
    "expo-file-system": "58.0.13",
    "expo-font": "58.0.11",
    "expo-image": "58.0.18",
    "expo-linear-gradient": "58.0.3",
    "expo-linking": "58.0.16",
    "expo-router": "58.0.30",
    "expo-splash-screen": "58.0.13",
    "qss": "3.0.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-nitro-modules": "0.37.2",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-unistyles": "3.8.1",
    "react-redux": "9.3.1",
    "redux-saga": "1.5.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@eslint-react/eslint-plugin": "5.28.8",
    "@eslint/js": "10.0.1",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/jest": "29.5.14",
    "@types/react": "19.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-jest": "29.17.0",
    "expo-doctor": "1.21.6",
    "jest": "29.7.0",
    "jest-expo": "58.0.14",
    "npm-run-all": "4.1.5",
    "prettier": "3.9.10",
    "test-renderer": "1.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
