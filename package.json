{
  "name": "hypnose-detente",
  "version": "2.6.0-SNAPSHOT",
  "description": "Application that allows you to relax with self-hypnosis recordings.",
  "author": "lacour-vincent",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=24.12.x",
    "yarn": "1.22.22"
  },
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "prebuild:android": "expo prebuild --platform android --clean --no-install",
    "android": "expo run:android",
    "build-app": "bash scripts/build-app.sh",
    "install-app": "bash scripts/install-app.sh",
    "type-check": "tsc --noEmit",
    "format-check": "prettier --check \"**/src/**/*.{ts,tsx}\" --log-level=warn",
    "lint-check": "eslint \"**/src/**/*.{ts,tsx}\"",
    "doctor": "yarn expo-doctor",
    "validate": "npm-run-all --parallel type-check format-check lint-check",
    "test:unit": "jest --config=jest.unit.config.js",
    "test:integration": "jest --config=jest.integration.config.js",
    "test": "yarn run test:unit && yarn run test:integration",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@react-native-community/slider": "5.2.0",
    "@react-native-vector-icons/material-design-icons": "13.1.2",
    "@reduxjs/toolkit": "2.12.0",
    "expo": "56.0.11",
    "expo-application": "56.0.03",
    "expo-asset": "56.0.17",
    "expo-audio": "56.0.12",
    "expo-build-properties": "56.0.18",
    "expo-constants": "56.0.18",
    "expo-file-system": "56.0.8",
    "expo-font": "56.0.6",
    "expo-image": "56.0.11",
    "expo-linear-gradient": "56.0.4",
    "expo-linking": "56.0.14",
    "expo-router": "56.2.10",
    "expo-splash-screen": "56.0.10",
    "qss": "3.0.0",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-nitro-modules": "0.35.9",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-unistyles": "3.2.5",
    "react-redux": "9.3.0",
    "redux-saga": "1.5.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@eslint/js": "9.39.4",
    "@react-native/jest-preset": "0.85.3",
    "@testing-library/react-native": "14.0.0",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.15",
    "eslint": "9.39.4",
    "eslint-plugin-jest": "29.15.2",
    "eslint-plugin-react": "7.37.5",
    "expo-doctor": "1.19.8",
    "jest": "29.7.0",
    "jest-expo": "56.0.5",
    "npm-run-all": "4.1.5",
    "prettier": "3.8.4",
    "test-renderer": "1.2.0",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.0"
  }
}
