{
  "name": "hypnose-detente",
  "version": "2.3.0",
  "description": "Application that allows you to relax with self-hypnosis recordings.",
  "author": "lacour-vincent",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=24.12.x",
    "yarn": "1.22.22"
  },
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "prebuild:android": "expo prebuild --platform android --clean",
    "android": "expo run:android",
    "build-app": "node scripts/build-app.mjs",
    "install-app": "node scripts/install-app.mjs",
    "type-check": "tsc --noEmit",
    "format-check": "prettier --check \"**/src/**/*.{ts,tsx}\" --log-level=warn",
    "lint-check": "eslint \"**/src/**/*.{ts,tsx}\"",
    "doctor": "yarn expo-doctor",
    "validate": "npm-run-all --parallel type-check format-check lint-check",
    "test:unit": "jest --config=jest.unit.config.js",
    "test:integration": "jest --config=jest.integration.config.js",
    "test": "yarn run test:unit && yarn run test:integration",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@react-native-community/slider": "5.1.2",
    "@reduxjs/toolkit": "2.11.2",
    "expo": "55.0.24",
    "expo-application": "55.0.15",
    "expo-asset": "55.0.17",
    "expo-audio": "55.0.14",
    "expo-build-properties": "55.0.14",
    "expo-constants": "55.0.16",
    "expo-font": "55.0.7",
    "expo-image": "55.0.10",
    "expo-linear-gradient": "55.0.14",
    "expo-linking": "55.0.15",
    "expo-router": "55.0.14",
    "expo-splash-screen": "55.0.21",
    "qss": "3.0.0",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-nitro-modules": "0.35.6",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.23.0",
    "react-native-unistyles": "3.2.4",
    "react-redux": "9.2.0",
    "redux-saga": "1.4.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@eslint/js": "9.39.4",
    "@testing-library/react-native": "13.3.3",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.14",
    "eslint": "9.39.4",
    "eslint-plugin-jest": "29.15.2",
    "eslint-plugin-react": "7.37.5",
    "expo-doctor": "1.18.22",
    "jest": "29.7.0",
    "jest-expo": "55.0.17",
    "npm-run-all": "4.1.5",
    "prettier": "3.8.3",
    "tsx": "4.21.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.3"
  }
}
