{
  "name": "hypnose-detente",
  "version": "2.0.0-SNAPSHOT",
  "description": "Application that allows you to relax with self-hypnosis recordings.",
  "author": "lacour-vincent",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.15.x",
    "yarn": "^1.22.x"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "prebuild:android": "expo prebuild --platform android --clean",
    "android": "expo run:android",
    "build:android": "eas build --local --platform android --profile dev",
    "type-check": "tsc --noEmit",
    "format-check": "prettier --check \"**/src/**/*.{ts,tsx}\" --log-level=warn",
    "lint-check": "eslint \"**/src/**/*.{ts,tsx}\"",
    "expo-check": "yarn expo-doctor",
    "validate": "npm-run-all --parallel type-check format-check lint-check expo-check",
    "test:unit": "jest --config=jest.unit.config.js",
    "test:integration": "jest --config=jest.integration.config.js",
    "test": "yarn run test:unit && yarn run test:integration",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.8.2",
    "expo": "53.0.19",
    "expo-build-properties": "0.14.8",
    "expo-constants": "17.1.7",
    "expo-font": "13.3.2",
    "expo-image": "2.3.2",
    "expo-linking": "7.1.7",
    "expo-router": "5.1.3",
    "expo-splash-screen": "0.30.10",
    "expo-status-bar": "2.2.3",
    "qss": "3.0.0",
    "react": "19.0.0",
    "react-native": "0.79.5",
    "react-native-paper": "5.14.5",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "4.11.1",
    "react-redux": "9.2.0",
    "redux-saga": "1.3.0"
  },
  "devDependencies": {
    "@babel/core": "7.28.0",
    "@eslint/js": "9.30.1",
    "@testing-library/react-native": "13.2.0",
    "@trivago/prettier-plugin-sort-imports": "5.2.2",
    "@types/jest": "29.5.14",
    "@types/react": "19.0.10",
    "eslint": "9.30.1",
    "eslint-plugin-jest": "29.0.1",
    "eslint-plugin-react": "7.37.5",
    "expo-doctor": "1.13.5",
    "jest": "29.7.0",
    "jest-expo": "53.0.9",
    "npm-run-all": "4.1.5",
    "prettier": "3.6.2",
    "react-test-renderer": "19.0.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.36.0"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "qss",
          "redux-saga"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
